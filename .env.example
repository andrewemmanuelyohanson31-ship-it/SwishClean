# Copy to .env and fill in from Supabase → Project Settings → API Keys.
# Both values are public by design (row-level security protects the data). NEVER put the secret/service_role key here.
# Leave empty to run the app on local sample data (demo mode, any 6-digit OTP works).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
