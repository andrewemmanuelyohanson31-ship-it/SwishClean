{
  "expo": {
    "name": "SwishClean",
    "slug": "SwishClean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SwishClean memakai galeri untuk mengunggah foto KTP, SKCK, dan foto hasil kerja.",
          "cameraPermission": "SwishClean memakai kamera untuk foto KTP, foto wajah, dan foto hasil kerja.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "swishclean",
    "extra": {
      "eas": {
        "projectId": "8b8ba545-0fb5-4ae3-9f55-c90c3e50638c"
      }
    },
    "owner": "andrewyohanson"
  }
}
